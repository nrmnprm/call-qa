# Option A: OpenRouter (https://openrouter.ai/keys). Free models end with ":free".
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
ALLOW_PAID_MODELS=0

# Option B: fully local with Ollama (`ollama serve`); no key needed.
# Start Ollama with OLLAMA_CONTEXT_LENGTH=12288: the default 4096 cuts long calls.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# Language of summaries, comments and coaching tips.
REPORT_LANGUAGE=English
# Attempts per stage before a call is marked failed.
MAX_ATTEMPTS=3
# 0 = never write recordings or results (read-only deployments).
# LLM_CACHE_WRITE=1
# DATA_WRITE=1
# Behind a reverse proxy: take the client address from X-Forwarded-For.
# TRUST_PROXY=1
HOST=127.0.0.1
PORT=4330
